{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    "group:allNonMajor",
    "schedule:weekly"
  ],
  "semanticCommits": "enabled",
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Keep @types/node on the Node floor in engines.node; raise this limit when engines.node is raised.",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<23"
    },
    {
      "description": "Workflow jobs pinned to Node 22.13 test the floor in engines.node; change them by hand when engines.node is raised.",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["node"],
      "matchCurrentValue": "22.13",
      "enabled": false
    },
    {
      "matchPackageNames": ["bun", "@types/bun"],
      "groupName": "bun"
    },
    {
      "description": "Update the docs site apart from the CLI, so a docs build break does not block CLI updates.",
      "matchFileNames": ["docs/**"],
      "groupName": "docs site"
    }
  ]
}
